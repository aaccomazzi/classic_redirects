Action legacy /cgi-bin/legacy_handler
<Files "insert_login">
SetHandler cgi-script
Options ExecCGI FollowSymlinks
</Files>
<Files ~ "^abs$|^pdf$|^full$|^doi$|^arXiv$|^index.html$|^$">
SetHandler legacy
Options ExecCGI FollowSymLinks
</Files>
<Files ~ "^(abstract|physics|preprint|advanced_fulltext|bulletins|default|education|fulltext|general|journals|proceedings|quick|toc)_service.html$">
SetHandler legacy
Options ExecCGI FollowSymLinks
</Files>
<Files ~ "^(ast|gen|phy|pre|author)_list.html$">
SetHandler legacy
Options ExecCGI FollowSymLinks
</Files>
<Files ~ "^(ast|custom|gen|phy|pre)_(bib|toc|toc_ascii).html$">
SetHandler legacy
Options ExecCGI FollowSymLinks
</Files>
<Files ~ "^(tocs|reset_cookie|basic_search|bib_abs).html$">
SetHandler legacy
Options ExecCGI FollowSymLinks
</Files>
<Files ~ "^(Groups|Journals|Proceedings)/(articles|proceedings|search|toc)$">
SetHandler legacy
Options ExecCGI FollowSymLinks
</Files>
<Files "^abs_doc/stopwords.html">
SetHandler legacy
Options ExecCGI FollowSymLinks
</Files>
#Action text/html /insert_login
RedirectMatch 301 ^/(local|mirror|z3950|www|books|BOBeo|pubs|cfa)/(.*) http://ads.harvard.edu/$1/$2
RedirectMatch 301 ^/(local|mirror|z3950|www|books|BOBeo|pubs|cfa)$ http://ads.harvard.edu/$1/
